  "root_causes": [
    {
      "id": "scalar_status_code",
      "count": 8,
      "description": "A scalar local (bool/int/uint32_t) assigned from a function whose NAME triggers the zero-config allocator heuristic (`_new`, `remalloc`, `*_alloc`) is a status code, not a heap pointer. The detector names the return-value variable as the leak target without checking its type.",
      "examples": ["nlog_is_time_to_create_new -> bool", "nlog_disk_monitor_remalloc -> uint32_t", "HpeDynmemAlloc -> uint32_t (real alloc is the &pNewNode out-param)", "db_get_pssp_harddisk_new_mount_dir -> int (real alloc is &mount_dir)"],
      "fix": "Skip a whole-variable allocation target whose declared base type is a builtin scalar (primitive_type/sized_type_specifier); typedef'd base types stay fail-open."
    },
    {
      "id": "getter_borrow",
      "count": 11,
      "description": "`get_*` / `get_*_addr` / `db_get_ctrl_item` accessors return a reference into a registry/static/cache, not a fresh allocation. The allocator-wrapper transitive closure (allocatorReturnFuncs) marks these get-or-create-and-cache functions as allocators, so every caller assignment looks like an owned allocation.",
      "examples": ["nlog_get_ai_detect_stat_list", "nlog_get_ai_detect_stat_node_by_time", "nlog_db_get_ctrl_item", "nlog_get_ips_severity_stat_addr"],
      "fix": "Do not mark a wrapper as an allocator when the pointer it returns ESCAPES (stored to a global/static/field or handed to a container) before returning — that is a borrow, not an ownership transfer."
    },
    {
      "id": "global_store_escape",
      "count": 1,
      "description": "An allocation stored directly into a global/static array (`g_seccloud_https_handle[log_type] = ..._new(...)`) is process-lifetime owned, not leaked by the function.",
      "fix": "Covered by the existing findEscapeLines subscript/field non-local-base escape; verify the LHS base is file-scope/static."
    },
    {
      "id": "ownership_transfer_to_callee",
      "count": 1,
      "description": "`nlog_db_create_new_ctrl_item` creates AND persists a control item into the DB (create-and-cache), so the returned pointer is owned by the DB, not the caller.",
      "fix": "Needs interprocedural ownership proof or a secguard.toml [ownership_transfer_calls] entry; medium confidence from naming alone."
    }
  ],
