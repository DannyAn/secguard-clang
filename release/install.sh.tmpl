#!/bin/bash
set -euo pipefail

# install.sh — SecGuard 统一包安装脚本（模板）
# 打包时占位标记会被替换为 sg_* 函数定义（内联注入）
# 此脚本自包含，无外部依赖

# @@SG_LIB_INJECT@@

PKG_DIR="$(cd "$(dirname "$0")" && pwd)"
PKG_VERSION="$(cat "$PKG_DIR/VERSION" 2>/dev/null || echo unknown)"

# 参数默认值
TARGET="all"
PREFIX=""
BIN_DIR=""
NO_BINARY=false
DO_UNINSTALL=false
DO_VERIFY=false
YES=false

usage() {
    cat <<EOF
SecGuard v${PKG_VERSION} Installer

默认安装（推荐，直接一条命令）：
    ./install.sh

    它会自动完成：
      - 检测当前操作系统与 CPU 架构（macOS/Linux/Windows × amd64/arm64），
        从包内选择对应的 secguard 二进制安装到 ~/.local/bin
        （若 /usr/local/bin 可写则优先装到 /usr/local/bin）；
      - 安装各 AI-agent 平台的扩展。

常用示例：
    ./install.sh                           # 全部安装（4 平台扩展 + 二进制）
    ./install.sh --target opencode         # 只装 OpenCode 扩展 + 二进制
    ./install.sh --target opencode-nga     # 只装 OpenCode 开源分支扩展 + 二进制
    ./install.sh --target claude-code      # 只装 Claude Code 官方插件 + 二进制
    ./install.sh --target claude-cac       # 只装 Claude Code 开源分支（~/.cac/）+ 二进制
    ./install.sh --no-binary               # 只装扩展，跳过二进制
    ./install.sh --verify                  # 安装后自检
    ./install.sh --uninstall --yes         # 卸载全部

Options:
  --target <opencode|opencode-nga|claude-code|claude-cac|all>
                                          安装目标平台（默认 all）
  --prefix <path>                         覆盖安装根目录
  --bin-dir <path>                        二进制安装目录（默认 /usr/local/bin，不可写时回退 ~/.local/bin）
  --no-binary                             跳过二进制安装
  --uninstall                             卸载模式
  --verify                                校验安装
  --yes, -y                               跳过交互确认
  --help, -h                              显示本帮助

环境变量覆盖：
  OPENCODE_DIR  OpenCode 根目录（默认 ~/.config/opencode）
  CLAUDE_DIR    Claude Code 根目录（默认 ~/.claude）
  CAC_DIR       Claude Code 开源分支根目录（默认 ~/.cac）
  BIN_DIR       二进制安装目录（默认 /usr/local/bin）
EOF
}

# 参数解析
while [ $# -gt 0 ]; do
    case "$1" in
        --target)    TARGET="$2"; shift 2 ;;
        --target=*)  TARGET="${1#--target=}"; shift ;;
        --prefix)    PREFIX="$2"; shift 2 ;;
        --prefix=*)  PREFIX="${1#--prefix=}"; shift ;;
        --bin-dir)   BIN_DIR="$2"; shift 2 ;;
        --bin-dir=*) BIN_DIR="${1#--bin-dir=}"; shift ;;
        --no-binary) NO_BINARY=true; shift ;;
        --uninstall) DO_UNINSTALL=true; shift ;;
        --verify)    DO_VERIFY=true; shift ;;
        --yes|-y)    YES=true; shift ;;
        --help|-h)   usage; exit 0 ;;
        *)           echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

# 互斥检查
if [ "$DO_UNINSTALL" = true ] && [ "$DO_VERIFY" = true ]; then
    echo "ERROR: --uninstall and --verify are mutually exclusive" >&2
    exit 2
fi

# 路径解析
OC_PREFIX="${PREFIX:-${OPENCODE_DIR:-$HOME/.config/opencode}}"
CC_PREFIX="${PREFIX:-${CLAUDE_DIR:-$HOME/.claude}}"
CAC_PREFIX="${PREFIX:-${CAC_DIR:-$HOME/.cac}}"
if [ -n "$BIN_DIR" ]; then
    : # use explicit
else
    BIN_DIR="${BIN_DIR_ENV:-/usr/local/bin}"
fi
OC_TARGET_DIR="$OC_PREFIX/extensions/secguard-clang"
CC_TARGET_DIR="$CC_PREFIX/plugins/secguard-clang"
CAC_TARGET_DIR="$CAC_PREFIX/plugins/secguard-clang"
OC_MANIFEST="$OC_PREFIX/.secguard-install-manifest"
OC_NGA_MANIFEST="$OC_PREFIX/.secguard-install-manifest-nga"
CC_MANIFEST="$CC_PREFIX/.secguard-install-manifest"
CAC_MANIFEST="$CAC_PREFIX/.secguard-install-manifest"

# 已安装文件记录
SG_FILES_LOG=""
sg_init_files_log() {
    SG_FILES_LOG=$(mktemp)
}
sg_record_file() {
    echo "$1" >> "$SG_FILES_LOG"
}
sg_files_csv() {
    if [ -n "$SG_FILES_LOG" ] && [ -f "$SG_FILES_LOG" ]; then
        paste -sd, "$SG_FILES_LOG" 2>/dev/null || true
    fi
}
sg_cleanup_files_log() {
    [ -n "$SG_FILES_LOG" ] && rm -f "$SG_FILES_LOG" 2>/dev/null || true
}

# 复制文件并记录
sg_cp_record() {
    local src="$1"
    local dst="$2"
    cp "$src" "$dst"
    sg_record_file "$(cd "$(dirname "$dst")" && pwd)/$(basename "$dst")"
}

# 复制 shared skills 到目标 skills 目录
sg_install_skills() {
    local target_skills_dir="$1"
    local skill_dir skill_name
    for skill_dir in "$PKG_DIR"/shared/skills/*/; do
        [ -d "$skill_dir" ] || continue
        skill_name=$(basename "$skill_dir")
        mkdir -p "$target_skills_dir/$skill_name"
        sg_cp_record "$skill_dir/SKILL.md" "$target_skills_dir/$skill_name/SKILL.md"
    done
}

# 安装 OpenCode extension
install_opencode() {
    echo "[opencode] Installing to $OC_TARGET_DIR"
    local src="$PKG_DIR/opencode"
    sg_cleanup_legacy_flat "$OC_PREFIX" "$PKG_DIR"
    mkdir -p "$OC_TARGET_DIR"/{commands,agents,tools,plugins,skills}

    [ -f "$src/extension.json" ] && sg_cp_record "$src/extension.json" "$OC_TARGET_DIR/extension.json"
    [ -f "$src/opencode.json" ]  && sg_cp_record "$src/opencode.json"  "$OC_TARGET_DIR/opencode.json"

    local f
    for f in "$src"/commands/*.md; do [ -f "$f" ] && sg_cp_record "$f" "$OC_TARGET_DIR/commands/$(basename "$f")"; done
    for f in "$src"/agents/*.md;   do [ -f "$f" ] && sg_cp_record "$f" "$OC_TARGET_DIR/agents/$(basename "$f")"; done
    for f in "$src"/tools/*.ts;    do [ -f "$f" ] && sg_cp_record "$f" "$OC_TARGET_DIR/tools/$(basename "$f")"; done
    for f in "$src"/plugins/*.ts;  do [ -f "$f" ] && sg_cp_record "$f" "$OC_TARGET_DIR/plugins/$(basename "$f")"; done

    sg_install_skills "$OC_TARGET_DIR/skills"

    # 写 manifest
    local files_csv
    files_csv=$(sg_files_csv)
    sg_write_install_manifest "$OC_MANIFEST" "$PKG_VERSION" "opencode" "" "$files_csv"
    echo "[opencode] Done"
}

# 安装 OpenCode-NGA（OpenCode 开源分支：manifest 用 codeagent-extension.json）
install_opencode_nga() {
    echo "[opencode-nga] Installing to $OC_TARGET_DIR"
    local src="$PKG_DIR/opencode-nga"
    sg_cleanup_legacy_flat "$OC_PREFIX" "$PKG_DIR"
    # 清理 <=0.4.4 的旧清单名（code-extension*.json），避免扩展目录里出现两套清单。
    rm -f "$OC_TARGET_DIR/code-extension.json" "$OC_TARGET_DIR/code-extension-install.json"
    mkdir -p "$OC_TARGET_DIR"/{commands,agents,tools,plugins,skills}

    [ -f "$src/codeagent-extension.json" ] && sg_cp_record "$src/codeagent-extension.json" "$OC_TARGET_DIR/codeagent-extension.json"
    # .codeagent-extension-install.json 的 source 替换为实际安装目录（绝对路径）。
    # 用 python3 做字面替换（sed 会把路径里的 `&`/`|` 当作特殊字符）。
    if [ -f "$src/.codeagent-extension-install.json" ]; then
        python3 -c "
src = '''$src/.codeagent-extension-install.json'''
dst = '''$OC_TARGET_DIR/.codeagent-extension-install.json'''
target = '''$OC_TARGET_DIR'''
with open(src) as f:
    content = f.read()
with open(dst, 'w') as f:
    f.write(content.replace('{{OC_TARGET_DIR}}', target))
"
        sg_record_file "$(cd "$(dirname "$OC_TARGET_DIR/.codeagent-extension-install.json")" && pwd)/$(basename "$OC_TARGET_DIR/.codeagent-extension-install.json")"
    fi
    [ -f "$src/opencode.json" ]  && sg_cp_record "$src/opencode.json"  "$OC_TARGET_DIR/opencode.json"

    local f
    for f in "$src"/commands/*.md; do [ -f "$f" ] && sg_cp_record "$f" "$OC_TARGET_DIR/commands/$(basename "$f")"; done
    for f in "$src"/agents/*.md;   do [ -f "$f" ] && sg_cp_record "$f" "$OC_TARGET_DIR/agents/$(basename "$f")"; done
    for f in "$src"/tools/*.ts;    do [ -f "$f" ] && sg_cp_record "$f" "$OC_TARGET_DIR/tools/$(basename "$f")"; done
    for f in "$src"/plugins/*.ts;  do [ -f "$f" ] && sg_cp_record "$f" "$OC_TARGET_DIR/plugins/$(basename "$f")"; done

    sg_install_skills "$OC_TARGET_DIR/skills"

    # 写 manifest
    local files_csv
    files_csv=$(sg_files_csv)
    sg_write_install_manifest "$OC_NGA_MANIFEST" "$PKG_VERSION" "opencode-nga" "" "$files_csv"
    echo "[opencode-nga] Done"
}

# 安装 ClaudeCode 官方插件（~/.claude/plugins/，而非 skills/）
install_claude_code() {
    echo "[claude-code] Installing to $CC_TARGET_DIR"
    local src="$PKG_DIR/claude-code"
    mkdir -p "$CC_TARGET_DIR"/{.claude-plugin,commands,agents,hooks,skills}

    [ -f "$src/.claude-plugin/plugin.json" ] && sg_cp_record "$src/.claude-plugin/plugin.json" "$CC_TARGET_DIR/.claude-plugin/plugin.json"
    [ -f "$src/hooks/hooks.json" ] && sg_cp_record "$src/hooks/hooks.json" "$CC_TARGET_DIR/hooks/hooks.json"

    local f
    for f in "$src"/.claude/commands/*.md; do [ -f "$f" ] && sg_cp_record "$f" "$CC_TARGET_DIR/commands/$(basename "$f")"; done
    for f in "$src"/.claude/agents/*.md;   do [ -f "$f" ] && sg_cp_record "$f" "$CC_TARGET_DIR/agents/$(basename "$f")"; done

    sg_install_skills "$CC_TARGET_DIR/skills"

    # 合并权限
    echo "[claude-code] Merging permissions into $CC_PREFIX/settings.json"
    sg_merge_permissions "$CC_PREFIX/settings.json"

    # CodeAgent 插件注册（installed_plugins.json + enabledPlugins + codeagent-extension.json）
    local cc_cache_dir="$CC_PREFIX/plugins/cache/local-secguard/secguard-clang/$PKG_VERSION"
    mkdir -p "$cc_cache_dir"
    # 用 `/.` 而非 `/*`：`*` 不匹配点文件，会漏掉 .claude-plugin/（插件清单）。
    cp -r "$CC_TARGET_DIR"/. "$cc_cache_dir/" 2>/dev/null || true
    sg_write_codeagent_extension "$cc_cache_dir" "$PKG_VERSION"
    sg_write_codeagent_extension "$CC_TARGET_DIR" "$PKG_VERSION"
    sg_record_file "$cc_cache_dir/codeagent-extension.json"
    sg_record_file "$CC_TARGET_DIR/codeagent-extension.json"
    sg_register_plugin "$CC_PREFIX/plugins/installed_plugins.json" "secguard-clang" "local-secguard" "$cc_cache_dir" "$PKG_VERSION"
    sg_enable_plugin "$CC_PREFIX/settings.json" "secguard-clang" "local-secguard"

    # 写 manifest
    local files_csv
    files_csv=$(sg_files_csv)
    sg_write_install_manifest "$CC_MANIFEST" "$PKG_VERSION" "claude-code" "" "$files_csv"
    echo "[claude-code] Done"
}

# 安装 ClaudeCAC（Claude Code 开源分支，~/.cac/plugins/）
install_claude_cac() {
    echo "[claude-cac] Installing to $CAC_TARGET_DIR"
    local src="$PKG_DIR/claude-cac"
    mkdir -p "$CAC_TARGET_DIR"/{.cac-plugin,commands,agents,hooks,skills}

    [ -f "$src/.cac-plugin/plugin.json" ] && sg_cp_record "$src/.cac-plugin/plugin.json" "$CAC_TARGET_DIR/.cac-plugin/plugin.json"
    [ -f "$src/hooks/hooks.json" ] && sg_cp_record "$src/hooks/hooks.json" "$CAC_TARGET_DIR/hooks/hooks.json"

    local f
    for f in "$src"/.cac/commands/*.md; do [ -f "$f" ] && sg_cp_record "$f" "$CAC_TARGET_DIR/commands/$(basename "$f")"; done
    for f in "$src"/.cac/agents/*.md;   do [ -f "$f" ] && sg_cp_record "$f" "$CAC_TARGET_DIR/agents/$(basename "$f")"; done

    sg_install_skills "$CAC_TARGET_DIR/skills"

    # 合并权限
    echo "[claude-cac] Merging permissions into $CAC_PREFIX/settings.json"
    sg_merge_permissions "$CAC_PREFIX/settings.json"

    # CodeAgent 插件注册（installed_plugins.json + enabledPlugins + codeagent-extension.json）
    local cac_cache_dir="$CAC_PREFIX/plugins/cache/local-secguard/secguard-clang/$PKG_VERSION"
    mkdir -p "$cac_cache_dir"
    # 用 `/.` 而非 `/*`：`*` 不匹配点文件，会漏掉 .cac-plugin/（插件清单）。
    cp -r "$CAC_TARGET_DIR"/. "$cac_cache_dir/" 2>/dev/null || true
    sg_write_codeagent_extension "$cac_cache_dir" "$PKG_VERSION"
    sg_write_codeagent_extension "$CAC_TARGET_DIR" "$PKG_VERSION"
    sg_record_file "$cac_cache_dir/codeagent-extension.json"
    sg_record_file "$CAC_TARGET_DIR/codeagent-extension.json"
    sg_register_plugin "$CAC_PREFIX/plugins/installed_plugins.json" "secguard-clang" "local-secguard" "$cac_cache_dir" "$PKG_VERSION"
    sg_enable_plugin "$CAC_PREFIX/settings.json" "secguard-clang" "local-secguard"

    # 写 manifest
    local files_csv
    files_csv=$(sg_files_csv)
    sg_write_install_manifest "$CAC_MANIFEST" "$PKG_VERSION" "claude-cac" "" "$files_csv"
    echo "[claude-cac] Done"
}

# 安装二进制
install_binary() {
    if [ "$NO_BINARY" = true ]; then
        echo "[binary] Skipped (--no-binary)"
        return 0
    fi
    local cur_os cur_arch
    cur_os=$(sg_detect_os)
    cur_arch=$(sg_detect_arch)
    local bin
    if ! bin=$(sg_select_binary "$PKG_DIR" "$cur_os" "$cur_arch"); then
        return 1
    fi
    # 确定可写 bin_dir
    local target_bin_dir="$BIN_DIR"
    if [ ! -w "$BIN_DIR" ] && [ "$EUID" -ne 0 ] 2>/dev/null; then
        target_bin_dir="$HOME/.local/bin"
        mkdir -p "$target_bin_dir"
        echo "[binary] $BIN_DIR not writable, using $target_bin_dir"
    fi
    mkdir -p "$target_bin_dir"
    if [ "$cur_os" = "windows" ]; then
        cp "$bin" "$target_bin_dir/secguard.exe"
        sg_record_file "$target_bin_dir/secguard.exe"
        echo "[binary] Installed to $target_bin_dir/secguard.exe"
    else
        cp "$bin" "$target_bin_dir/secguard"
        chmod +x "$target_bin_dir/secguard"
        sg_record_file "$target_bin_dir/secguard"
        echo "[binary] Installed to $target_bin_dir/secguard"
    fi
}

# 生成用户级配置文件模板（若不存在）。配置文件统一在 .codeagent 命名空间下
# （~/.codeagent/secguard.toml），与项目级 .codeagent/secguard.toml、运行时
# 数据目录 .codeagent/secguard-clang/ 保持一致；独立于二进制和 extension，
# 卸载/重装不会删除。
install_config_template() {
    local cfg_file="$HOME/.codeagent/secguard.toml"
    if [ -f "$cfg_file" ]; then
        return 0
    fi
    mkdir -p "$HOME/.codeagent"
    cat > "$cfg_file" <<'TOML'
# SecGuard 配置文件（可选）。卸载/重装 secguard 不会删除此文件。
# 大多数用户无需修改此文件；运行 `secguard config --help` 查看完整说明，
# `secguard config` 查看当前生效配置，`secguard config --example` 查看示例。
#
# 可信访问宏白名单：这些宏展开为「字段 + 指针偏移」的地址计算，
# 返回指针默认可信、调用方直接解引用不判空，因此不报空指针解引用。
# 用于第三方/内部 SDK 的访问宏（宏定义在扫描范围外时自动识别失效）。
[trusted_macros]
names = [
    # "YOUR_ACCESSOR_MACRO",
]
TOML
    echo "[config] Generated $cfg_file"
}

# 检查并卸载旧版本
check_and_uninstall_old() {
    local manifest="$1"
    local platform="$2"
    if [ -f "$manifest" ]; then
        local old_version
        old_version=$(python3 -c "
import json
try:
    with open('''$manifest''') as f: print(json.load(f).get('version',''))
except: print('')
" 2>/dev/null) || old_version=""
        if [ -n "$old_version" ] && [ "$old_version" != "$PKG_VERSION" ]; then
            echo "[info] Detected old version $old_version, uninstalling first..."
            sg_uninstall_platform "$platform" "" "" "$manifest" "true" 2>/dev/null || true
        fi
    fi
}

# ── 主逻辑 ──

if [ "$DO_VERIFY" = true ]; then
    sg_verify_platform "$TARGET" "$PREFIX" "$BIN_DIR" "$PKG_VERSION"
    exit $?
fi

if [ "$DO_UNINSTALL" = true ]; then
    echo "SecGuard v${PKG_VERSION} — Uninstalling (target: $TARGET)"
    echo "========================================================"
    yes_flag="false"
    [ "$YES" = true ] && yes_flag="true"
    case "$TARGET" in
        opencode)
            sg_uninstall_platform "opencode" "$OC_PREFIX" "$BIN_DIR" "$OC_MANIFEST" "$yes_flag"
            ;;
        opencode-nga)
            sg_uninstall_platform "opencode-nga" "$OC_PREFIX" "$BIN_DIR" "$OC_NGA_MANIFEST" "$yes_flag"
            ;;
        claude-code)
            sg_uninstall_platform "claude-code" "$CC_PREFIX" "$BIN_DIR" "$CC_MANIFEST" "$yes_flag"
            ;;
        claude-cac)
            sg_uninstall_platform "claude-cac" "$CAC_PREFIX" "$BIN_DIR" "$CAC_MANIFEST" "$yes_flag"
            ;;
        all)
            sg_uninstall_platform "opencode" "$OC_PREFIX" "$BIN_DIR" "$OC_MANIFEST" "$yes_flag"
            sg_uninstall_platform "opencode-nga" "$OC_PREFIX" "$BIN_DIR" "$OC_NGA_MANIFEST" "$yes_flag"
            sg_uninstall_platform "claude-code" "$CC_PREFIX" "$BIN_DIR" "$CC_MANIFEST" "$yes_flag"
            sg_uninstall_platform "claude-cac" "$CAC_PREFIX" "$BIN_DIR" "$CAC_MANIFEST" "$yes_flag"
            ;;
        *) echo "Unknown target: $TARGET" >&2; exit 2 ;;
    esac
    echo ""
    echo "Uninstall complete."
    exit 0
fi

# 安装模式
echo "SecGuard v${PKG_VERSION} — Installing (target: $TARGET)"
echo "========================================================"
echo "  Package: $PKG_DIR"
echo ""

sg_init_files_log

# 卸载旧版本
case "$TARGET" in
    opencode|opencode-nga|all)
        check_and_uninstall_old "$OC_MANIFEST" "opencode"
        check_and_uninstall_old "$OC_NGA_MANIFEST" "opencode-nga"
        ;;
esac
case "$TARGET" in
    claude-code|claude-cac|all)
        check_and_uninstall_old "$CC_MANIFEST" "claude-code"
        check_and_uninstall_old "$CAC_MANIFEST" "claude-cac"
        ;;
esac

# 执行安装
case "$TARGET" in
    opencode)
        install_opencode
        install_binary
        install_config_template
        ;;
    opencode-nga)
        install_opencode_nga
        install_binary
        install_config_template
        ;;
    claude-code)
        install_claude_code
        install_binary
        install_config_template
        ;;
    claude-cac)
        install_claude_cac
        install_binary
        install_config_template
        ;;
    all)
        install_opencode
        echo ""
        install_opencode_nga
        echo ""
        install_claude_code
        echo ""
        install_claude_cac
        echo ""
        install_binary
        install_config_template
        ;;
    *) echo "Unknown target: $TARGET" >&2; sg_cleanup_files_log; exit 2 ;;
esac

sg_cleanup_files_log

echo ""
echo "╔══════════════════════════════════════════════════════════╗"
echo "║              Installation Complete                       ║"
echo "╠══════════════════════════════════════════════════════════╣"
case "$TARGET" in
    opencode|all)
        echo "║  OpenCode:  $OC_TARGET_DIR"
        ;;
esac
case "$TARGET" in
    opencode-nga|all)
        echo "║  OpenCode-NGA: $OC_TARGET_DIR (codeagent-extension.json)"
        ;;
esac
case "$TARGET" in
    claude-code|all)
        echo "║  ClaudeCode: $CC_TARGET_DIR"
        ;;
esac
case "$TARGET" in
    claude-cac|all)
        echo "║  ClaudeCAC: $CAC_TARGET_DIR"
        ;;
esac
echo "║  Command:   /secguard [path]"
echo "╚══════════════════════════════════════════════════════════╝"
echo ""
echo "Verify with: ./install.sh --verify"
echo "Uninstall with: ./uninstall.sh --target $TARGET --yes"
