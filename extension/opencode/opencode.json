{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "security-auditor": {
      "mode": "all",

      "temperature": 0.1,
      "steps": 200,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "skill": "allow",
        "secguard_scan": "allow",
        "secguard_index": "allow",
        "secguard_plan": "allow",
        "secguard_report": "allow",
        "secguard_status": "allow",
        "secguard_db": "allow",
        "secguard_schema": "allow"
      }
    }
  },
  "permission": {
    "external_directory": "allow",
    "secguard_scan": "allow",
    "secguard_index": "allow",
    "secguard_plan": "allow",
    "secguard_report": "allow",
    "secguard_status": "allow",
    "secguard_db": "allow",
    "secguard_schema": "allow"
  },
  "plugin": ["secguard-context"]
}