    {"id": "PH1-01", "category": "phase1_integer_overflow", "file": "src/allocator.c", "line": 110,
     "code": "return malloc(count * obj_size)", "cwe": "CWE-190", "detector": "integer_overflow", "expected": "confirmed — count * obj_size can overflow, no bounds check before malloc"},
    {"id": "PH1-02", "category": "phase1_race_condition", "file": "src/system.c", "line": 44,
