    {"id": "PH1-03", "category": "phase1_race_condition", "file": "src/system.c", "line": 57,
     "code": "openat(dir_fd, path, O_RDONLY | O_NOFOLLOW)", "cwe": "CWE-362", "detector": "race_condition", "expected": "false-positive — O_NOFOLLOW rejects symlinks atomically, no TOCTOU"},
