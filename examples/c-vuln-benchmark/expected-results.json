    {"id": "PH1-06", "category": "phase1_hardcoded_secret", "file": "src/windows.c", "line": 69,
     "code": "RegSetValueExA(hKey, \"Password\", 0, REG_SZ, (BYTE*)\"P@ssw0rd!\", 9)", "cwe": "CWE-798", "detector": "hardcoded_secret", "expected": "confirmed — credential persistence: hardcoded password written to registry"},
    {"id": "PH1-07", "category": "phase1_deadlock", "file": "src/concurrency.c", "line": 36,
     "code": "lock(A); lock(B); // vs lock(B); lock(A) in thread_deadlock_b", "cwe": "CWE-667", "detector": "deadlock", "expected": "confirmed — lock-order inversion: thread A locks A→B, thread B locks B→A"},
    {"id": "PH1-08", "category": "phase1_crypto_misuse", "file": "src/crypto.c", "line": 29,
